{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "ttl": {
      "type": "string",
      "description": "Positive duration such as 20m; runtime validates seconds and bounds."
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "minLength": 1
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "exact": {
                  "type": "string"
                }
              },
              "required": [
                "exact"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "one_of": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "one_of"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "range": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "number",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "max": {
                      "type": "number",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "range"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "pattern"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "subpath": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "required": [
                "subpath"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "wildcard": {
                  "const": true
                }
              },
              "required": [
                "wildcard"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "approvals": {
      "type": "object",
      "required": [
        "keys",
        "gates"
      ],
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Public key file paths, relative to the policy file. Any one authorized signature is sufficient."
        },
        "gates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "always": {
                "const": true,
                "type": "boolean"
              }
            },
            "required": [
              "always"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "required": [
    "version",
    "capabilities"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Tenuo scope policy, versions 1 and 2",
  "description": "A scope template, not authority. Version 2 adds public-key approval gates. Runtime also checks key files, granted gate tools, and numeric/duration bounds.",
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "approvals"
          ]
        }
      }
    }
  ]
}
